{
  "manifest_version": 3,
  "name": "ClipRun",
  "version": "1.0.3",
  "description": "Side-panel clipboard snippet runner — save, search and re-run your text snippets instantly",
  "permissions": [
    "sidePanel",
    "scripting",
    "clipboardRead",
    "storage",
    "tabs",
    "activeTab",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {},
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}